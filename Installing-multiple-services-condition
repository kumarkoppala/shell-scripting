#!/bin/bash

# 1. Define log file path correctly
LOG_FILE="/var/log/services.log"

# Create the file if it doesn't exist
touch "$LOG_FILE"

services=("mysql" "nginx" "http")
uid=$(id -u)

if [ "$uid" -ne 0 ]; then
    echo "Please run command with sudo"
    exit 1
fi

# 2. Corrected VALIDATE function using dynamic arguments
VALIDATE(){
    local service_name=$1
    local exit_status=$2
    
    if [ "$exit_status" -eq 0 ]; then
        echo "$service_name is already installed." | tee -a "$LOG_FILE"
    else
        echo "$service_name not found. Installing..." | tee -a "$LOG_FILE"
        # Map generic names to exact package names if needed
        if [ "$service_name" == "mysql" ]; then
            dnf install mysql-server -y >> "$LOG_FILE" 2>&1
        else
            dnf install "$service_name" -y >> "$LOG_FILE" 2>&1
        fi
    fi
}

# 3. Check and validate MySQL
if [ "${services[0]}" == "mysql" ]; then
    mysql --version &> /dev/null
    VALIDATE "mysql" $?
fi

# 4. Check and validate Nginx
if [ "${services[1]}" == "nginx" ]; then
    nginx -v &> /dev/null
    VALIDATE "nginx" $?
fi
