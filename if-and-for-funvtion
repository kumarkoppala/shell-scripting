log_file="/home/ec2-user/$(basename "$0").logs"
touch $log_file
TIMESTAMP=$(date "+%Y-%m-%d %H:%M:%S")

R="\e[31m"
G="\e[32m"
Y="\e[33m"
N="\e[0m"

uid=$(id -u)
if [ $uid -ne 0 ]; then
echo "$TIMESTAMP please execute script with super user" | tee -a $log_file
exit 1
fi

validate(){
    if [ $2 -eq 0 ]; then
    echo "$TIMESTAMP $R [INFO] $N $1 installed successfully" | tee -a $log_file
    else
    echo "$R $1 failed $N" | tee -a $log_file
    fi
}
for service in $@
do
dnf list installed $service >> "$log_file" 2>&1
if [ $? -eq 0 ]; then
echo "package is already installed" >> "$log_file"

else
dnf install $service -y >> "$log_file" 2>&1
validate "$service" $?
fi
done



